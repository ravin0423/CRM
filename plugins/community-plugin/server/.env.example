# HTTP port for the plugin backend
PORT=8787

# Comma-separated origins allowed to embed the plugin / call this API.
# Replace with the real SureMDM console origin(s) before deploying.
ALLOWED_HOST_ORIGINS=http://localhost:8788

# Base URL of the SureMDM instance used to verify a session token that the
# console hands the plugin. Replace path/contract once confirmed against the
# live SPDK docs.
SUREMDM_API_BASE=https://your-suremdm-server.example.com
SUREMDM_SESSION_VERIFY_PATH=/api/session/whoami

# community.42gears.com integration
COMMUNITY_BASE_URL=https://community.42gears.com

# Which SSO adapter to use. "discourse" is the default, standards-based
# guess; confirm what community.42gears.com actually runs and adjust
# src/ssoProvider.js if it differs (e.g. SAML, a custom JWT callback).
SSO_PROVIDER=discourse
DISCOURSE_SSO_SECRET=replace-with-shared-secret-from-community-admin

# Set to "true" only for local development: skips real SureMDM session
# verification and returns a fixed mock user. Never enable in production.
DEV_MOCK_SESSION=false
